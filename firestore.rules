rules_version = '2';

// ============================================================================
// Total Tools — Reglas de seguridad de Firestore
// ----------------------------------------------------------------------------
// PRINCIPIO:
//   • El PANEL (index.html) inicia sesión con Firebase Auth y envía el token
//     (Authorization: Bearer ...) en cada llamada.
//   • Antes exigíamos solo "request.auth != null" → CUALQUIER usuario logueado
//     entraba. Ahora exigimos que el correo esté en la LISTA DE ADMINS de abajo,
//     así aunque alguien se registre por su cuenta NO accede a tus datos.
//   • El PÚBLICO (formulario / seguimiento) NO toca Firestore directo: pasa por
//     la Cloud Function "formApi" (Admin SDK), que ignora estas reglas. Por eso
//     aquí el público queda completamente cerrado.
// MANTENIMIENTO:
//   • Para agregar/quitar un administrador, edita la lista ADMINS de abajo y
//     vuelve a desplegar: firebase deploy --only firestore:rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Quién es administrador ────────────────────────────────────────────
    //
    // ⚠️ EL CORREO SOLO VALE SI ESTÁ VERIFICADO, y esto no es un detalle.
    //
    // Firebase, con correo/contraseña activado, deja que CUALQUIERA cree una
    // cuenta con CUALQUIER correo — no comprueba que sea suyo. Sin la
    // comprobación de abajo, alguien que sepa uno de estos correos podía
    // registrarse con él, poner su propia contraseña, y entrar a los datos del
    // negocio. Sin hackear nada.
    //
    // `email_verified` solo es true cuando el proveedor confirmó la identidad:
    // Google siempre lo hace. Un registro con contraseña llega en false y
    // seguiría en false salvo que el atacante pueda leer ese buzón — que es
    // justo lo que no puede.
    //
    // ⚠️ SOLO ENTRAN CUENTAS DE GOOGLE. `email_verified` nunca es true en un
    // registro con contraseña, así que esta lista no se puede reclamar
    // registrándose con uno de estos correos.
    //
    // Se retiró admin@totaltools.com (20 sep 2026): era una cuenta creada a
    // mano, con un buzón que no existe y por tanto sin recuperación posible.
    // Una contraseña que no se puede cambiar ni recuperar no es una llave de
    // emergencia: es una llave perdida esperando a que alguien la encuentre.
    //
    // MANTENIMIENTO: agregar o quitar un administrador se hace aquí y con
    //   firebase deploy --only firestore:rules
    // (esto desaparece cuando pasemos a marcas en el usuario: ver docs).
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'jarryllanoski@gmail.com',
          'redbolima@gmail.com'
        ];
    }

    // Solo administradores acceden a "panel/**" (todos tus pedidos, tokens, config)
    match /panel/{document=**} {
      allow read, write: if esAdmin();
    }

    // Cualquier otra ruta: cerrada por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
